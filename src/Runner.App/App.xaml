<Application x:Class="ToolRunner.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <!-- black and gold (his pick); every colour is a token here -->
      <Color x:Key="BgColor">#0B0B0D</Color>
      <Color x:Key="PanelColor">#141418</Color>
      <Color x:Key="Panel2Color">#1B1B21</Color>
      <Color x:Key="LineColor">#2E2A20</Color>
      <Color x:Key="GoldColor">#D4AF37</Color>
      <Color x:Key="GoldLightColor">#F2D57A</Color>
      <Color x:Key="GoldDimColor">#7A6420</Color>
      <Color x:Key="TextColor">#ECE6D6</Color>
      <Color x:Key="MutedColor">#9A9384</Color>
      <Color x:Key="GoodColor">#6FCF8E</Color>
      <Color x:Key="BadColor">#E8776A</Color>
      <Color x:Key="WarnColor">#E8C06A</Color>
      <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
      <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
      <SolidColorBrush x:Key="Panel2" Color="{StaticResource Panel2Color}"/>
      <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
      <SolidColorBrush x:Key="Gold" Color="{StaticResource GoldColor}"/>
      <SolidColorBrush x:Key="GoldLight" Color="{StaticResource GoldLightColor}"/>
      <SolidColorBrush x:Key="GoldDim" Color="{StaticResource GoldDimColor}"/>
      <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
      <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
      <SolidColorBrush x:Key="Good" Color="{StaticResource GoodColor}"/>
      <SolidColorBrush x:Key="Bad" Color="{StaticResource BadColor}"/>
      <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}"/>
      <LinearGradientBrush x:Key="GoldBar" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8E6F1E" Offset="0"/>
        <GradientStop Color="#F2D57A" Offset="0.6"/>
        <GradientStop Color="#D4AF37" Offset="1"/>
      </LinearGradientBrush>
      <!-- the Fluent theme's accent, gold -->
      <Color x:Key="SystemAccentColor">#D4AF37</Color>
      <Color x:Key="SystemAccentColorLight1">#E2C25A</Color>
      <Color x:Key="SystemAccentColorLight2">#F2D57A</Color>
      <Color x:Key="SystemAccentColorLight3">#F8E6AE</Color>
      <Color x:Key="SystemAccentColorDark1">#B08F2A</Color>
      <Color x:Key="SystemAccentColorDark2">#8E6F1E</Color>
      <Color x:Key="SystemAccentColorDark3">#6B5317</Color>

      <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
      <FontFamily x:Key="HeadFont">Bahnschrift SemiBold, Segoe UI Semibold</FontFamily>
      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

      <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadFont}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Foreground" Value="{StaticResource GoldLight}"/>
      </Style>
      <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource Gold}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
      </Style>
      <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
      </Style>

      <!-- the gold primary button -->
      <Style x:Key="Primary" TargetType="Button">
        <Setter Property="Foreground" Value="#0B0B0D"/>
        <Setter Property="FontFamily" Value="{StaticResource HeadFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="26,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="b" Background="{StaticResource GoldBar}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <Border x:Name="focus" CornerRadius="8" BorderBrush="{StaticResource GoldLight}" BorderThickness="2" Margin="-3" Visibility="Collapsed"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.75"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.3"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- the outlined gold button -->
      <Style x:Key="Ghost" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource GoldLight}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="{StaticResource Panel2}" BorderBrush="{StaticResource GoldDim}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource GoldLight}"/>
                  <Setter TargetName="b" Property="Background" Value="#241F12"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource GoldLight}"/>
                  <Setter TargetName="b" Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- a gold check box (the Fluent one takes Windows' own accent colour) -->
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <StackPanel Orientation="Horizontal" Background="Transparent">
                <Grid Width="18" Height="18" VerticalAlignment="Center">
                  <Border x:Name="box" CornerRadius="4" BorderThickness="1.5" BorderBrush="{StaticResource GoldDim}" Background="{StaticResource Panel2}"/>
                  <Path x:Name="tick" Data="M 4,9 L 7.5,12.5 L 14,5.5" Stroke="#0B0B0D" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Grid>
                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="box" Property="Background" Value="{StaticResource Gold}"/>
                  <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Gold}"/>
                  <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{StaticResource GoldLight}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource GoldLight}"/>
                  <Setter TargetName="box" Property="BorderThickness" Value="2.5"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="Foreground" Value="{StaticResource Bad}"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
