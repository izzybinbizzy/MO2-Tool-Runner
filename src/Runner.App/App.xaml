<Application x:Class="ToolRunner.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <!-- black and gold (his pick); every colour is a token here -->
      <Color x:Key="BgColor">#0B0B0D</Color>
      <Color x:Key="PanelColor">#141418</Color>
      <Color x:Key="Panel2Color">#1B1B21</Color>
      <Color x:Key="LineColor">#2E2A20</Color>
      <Color x:Key="GoldColor">#D4AF37</Color>
      <Color x:Key="GoldLightColor">#F2D57A</Color>
      <Color x:Key="GoldDimColor">#7A6420</Color>
      <Color x:Key="TextColor">#ECE6D6</Color>
      <Color x:Key="MutedColor">#9A9384</Color>
      <Color x:Key="GoodColor">#6FCF8E</Color>
      <Color x:Key="BadColor">#E8776A</Color>
      <Color x:Key="WarnColor">#E8C06A</Color>
      <Color x:Key="OnAccentColor">#0B0B0D</Color>
      <Color x:Key="HoverFillColor">#241F12</Color>
      <Color x:Key="BannerBadColor">#3A1B17</Color>
      <Color x:Key="GuidedFillColor">#2A2410</Color>
      <Color x:Key="ShadeColor">#99000000</Color>
      <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
      <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
      <SolidColorBrush x:Key="Panel2" Color="{StaticResource Panel2Color}"/>
      <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
      <SolidColorBrush x:Key="Gold" Color="{StaticResource GoldColor}"/>
      <SolidColorBrush x:Key="GoldLight" Color="{StaticResource GoldLightColor}"/>
      <SolidColorBrush x:Key="GoldDim" Color="{StaticResource GoldDimColor}"/>
      <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
      <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
      <SolidColorBrush x:Key="Good" Color="{StaticResource GoodColor}"/>
      <SolidColorBrush x:Key="Bad" Color="{StaticResource BadColor}"/>
      <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}"/>
      <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}"/>
      <SolidColorBrush x:Key="HoverFill" Color="{StaticResource HoverFillColor}"/>
      <SolidColorBrush x:Key="BannerBad" Color="{StaticResource BannerBadColor}"/>
      <SolidColorBrush x:Key="GuidedFill" Color="{StaticResource GuidedFillColor}"/>
      <SolidColorBrush x:Key="Shade" Color="{StaticResource ShadeColor}"/>
      <LinearGradientBrush x:Key="GoldBar" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8E6F1E" Offset="0"/>
        <GradientStop Color="#F2D57A" Offset="0.6"/>
        <GradientStop Color="#D4AF37" Offset="1"/>
      </LinearGradientBrush>
      <!-- the Fluent theme's accent, gold -->
      <Color x:Key="SystemAccentColor">#D4AF37</Color>
      <Color x:Key="SystemAccentColorLight1">#E2C25A</Color>
      <Color x:Key="SystemAccentColorLight2">#F2D57A</Color>
      <Color x:Key="SystemAccentColorLight3">#F8E6AE</Color>
      <Color x:Key="SystemAccentColorDark1">#B08F2A</Color>
      <Color x:Key="SystemAccentColorDark2">#8E6F1E</Color>
      <Color x:Key="SystemAccentColorDark3">#6B5317</Color>
      <!-- a selected list row (past runs, steps): the Fluent one takes Windows' own accent, blue on most PCs -->
      <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="{DynamicResource GoldDimColor}" Opacity="0.55"/>
      <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush" Color="{DynamicResource GoldDimColor}" Opacity="0.7"/>
      <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPressedThemeBrush" Color="{DynamicResource GoldDimColor}" Opacity="0.85"/>
      <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressedThemeBrush" Color="{DynamicResource GoldDimColor}" Opacity="0.85"/>
      <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="{DynamicResource TextColor}"/>

      <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
      <FontFamily x:Key="HeadFont">Bahnschrift SemiBold, Segoe UI Semibold</FontFamily>
      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
      <!-- sizes and shapes a theme may change (Theme.cs) -->
      <sys:Double x:Key="SizeHeading1">22</sys:Double>
      <sys:Double x:Key="SizeStepTitle">26</sys:Double>
      <sys:Double x:Key="SizeClock">20</sys:Double>
      <sys:Double x:Key="SizeHeading2">15</sys:Double>
      <sys:Double x:Key="SizeVerdict">15</sys:Double>
      <sys:Double x:Key="SizeBody">14</sys:Double>
      <sys:Double x:Key="SizeSmall">12.5</sys:Double>
      <sys:Double x:Key="SizeLog">12.5</sys:Double>
      <sys:Double x:Key="SizePrimaryButton">15</sys:Double>
      <sys:Double x:Key="ProgressBarHeight">8</sys:Double>
      <CornerRadius x:Key="CardCorner">8</CornerRadius>
      <CornerRadius x:Key="ButtonCorner">6</CornerRadius>
      <CornerRadius x:Key="CheckBoxCorner">4</CornerRadius>
      <CornerRadius x:Key="GuidedBoxCorner">6</CornerRadius>
      <BitmapImage x:Key="Logo" UriSource="pack://application:,,,/Icon.ico"/>

      <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource SizeHeading1}"/>
        <Setter Property="Foreground" Value="{DynamicResource GoldLight}"/>
      </Style>
      <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource SizeHeading2}"/>
        <Setter Property="Foreground" Value="{DynamicResource Gold}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
      </Style>
      <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="{DynamicResource SizeSmall}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CardCorner}"/>
        <Setter Property="Padding" Value="16"/>
      </Style>

      <!-- the gold primary button -->
      <Style x:Key="Primary" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        <Setter Property="FontFamily" Value="{DynamicResource HeadFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource SizePrimaryButton}"/>
        <Setter Property="Padding" Value="26,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="b" Background="{DynamicResource GoldBar}" CornerRadius="{DynamicResource ButtonCorner}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <Border x:Name="focus" CornerRadius="8" BorderBrush="{DynamicResource GoldLight}" BorderThickness="2" Margin="-3" Visibility="Collapsed"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.75"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.3"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- the outlined gold button -->
      <Style x:Key="Ghost" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource GoldLight}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource GoldDim}" BorderThickness="1" CornerRadius="{DynamicResource ButtonCorner}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource GoldLight}"/>
                  <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverFill}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource GoldLight}"/>
                  <Setter TargetName="b" Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- a gold check box (the Fluent one takes Windows' own accent colour) -->
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <StackPanel Orientation="Horizontal" Background="Transparent">
                <Grid Width="18" Height="18" VerticalAlignment="Center">
                  <Border x:Name="box" CornerRadius="{DynamicResource CheckBoxCorner}" BorderThickness="1.5" BorderBrush="{DynamicResource GoldDim}" Background="{DynamicResource Panel2}"/>
                  <Path x:Name="tick" Data="M 4,9 L 7.5,12.5 L 14,5.5" Stroke="{DynamicResource OnAccent}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Grid>
                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="box" Property="Background" Value="{DynamicResource Gold}"/>
                  <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Gold}"/>
                  <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource GoldLight}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource GoldLight}"/>
                  <Setter TargetName="box" Property="BorderThickness" Value="2.5"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
